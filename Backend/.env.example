# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in this directory and supply your own values.
# IMPORTANT: Never commit '.env' or real credentials into version control!
# ==============================================================================

# Server Configuration (Required)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api

# Database - MongoDB (Required)
# Example Atlas: mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/medical_management
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/medical_management?retryWrites=true&w=majority

# Caching & Session Token Blacklist - Redis (Required)
# Example Cloud: redis://:<password>@<redis-host>:<port>
# Example Local: redis://localhost:6379
REDIS_URL=redis://:<password>@<redis-host>:<port>

# Authentication - JWT Secret (Required, must be at least 32 characters)
# Generate a strong key, e.g.: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_characters_long_min

# Google OAuth - Google Cloud Console > APIs & Services > Credentials
# Authorized JavaScript origin: http://localhost:5173
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to API_BASE_URL/auth/google/callback
GOOGLE_REDIRECT_URI=

# Apple Sign in with Apple - Apple Developer > Certificates, Identifiers & Profiles
# Configure the Services ID as APPLE_CLIENT_ID and register the HTTPS callback URL.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS#8 .p8 content; store as a single line with \n for newlines.
APPLE_PRIVATE_KEY=
# Optional; defaults to API_BASE_URL/auth/apple/callback
APPLE_REDIRECT_URI=

# Email Notifications - Nodemailer / SMTP (Optional)
# Used for OTP verification and doctor critical vitals alerts
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password

# SMS Notifications - Twilio (Optional)
TWILIO_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# Optional face enrollment and face sign-in using AWS Rekognition.
# Face sign-in uses 95% face similarity matching; it does not detect liveness.
# Create the collection once with AWS CLI. Grant the backend role
# rekognition:IndexFaces, rekognition:DeleteFaces, and
# rekognition:SearchFacesByImage on the collection plus rekognition:DetectFaces.
# Use the AWS SDK default credential chain (IAM role/profile); do not commit keys.
FACE_ENROLLMENT_ENABLED=false
AWS_REGION=us-east-1
REKOGNITION_COLLECTION_ID=medivanta-face-users-dev
# For local development, set AWS_PROFILE in the backend process environment.
# Production should use an attached IAM role or workload identity.
